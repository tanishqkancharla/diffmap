{
  "name": "@tanishqkancharla/diffmap",
  "version": "0.1.4",
  "description": "Serve a spec or code walkthrough as a local page",
  "license": "MIT",
  "author": "Tanishq Kancharla",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tanishqkancharla/diffmap.git"
  },
  "bin": {
    "diffmap": "bin.js"
  },
  "files": [
    "bin.js",
    "index.html",
    "src",
    "vite.config.ts"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "cli": "node --import tsx src/cli.ts",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings src vite.config.ts vite.gist.config.ts bin.js",
    "lint:fix": "oxlint --fix src vite.config.ts vite.gist.config.ts bin.js",
    "prepublishOnly": "npm run typecheck && npm run lint && npm run format:check",
    "release": "npm publish",
    "test": "tsx --test src/parseViewer.test.ts src/serve.test.ts src/gist/route.test.ts src/github/route.test.ts src/github/patch.test.ts src/github/fetchRepo.test.ts src/viewer/sourceHeader.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "build:gist": "vite build",
    "preview:gist": "vite preview --config vite.gist.config.ts --host 127.0.0.1 --port 4178"
  },
  "dependencies": {
    "@pierre/diffs": "1.4.1",
    "@vitejs/plugin-react": "^6.1.1",
    "beautiful-mermaid": "^1.1.3",
    "errore": "^0.14.1",
    "incur": "^0.4.20",
    "maui": "npm:@tanishqkancharla/maui@0.0.30",
    "md4x": "^0.0.29",
    "purse-styles": "^0.2.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsx": "^4.23.13",
    "vite": "^8.2.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@11.5.1"
}
