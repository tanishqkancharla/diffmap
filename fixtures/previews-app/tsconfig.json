{
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "types": ["vite/client"],
    "paths": {
      "@tanishqkancharla/diffmap/preview": ["../../src/preview/index.ts"]
    },
    "allowImportingTsExtensions": true
  },
  "include": ["src", ".storybook"]
}
