# Copy to .env at the repository root (gitignored), or set these as environment
# variables wherever `npm run cloud:deploy` runs. See cloud/README.md.

# Cloudflare: from `npx alchemy provider cloudflare token`. Not needed when
# `npx alchemy profile edit` has signed this machine in.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Authorizes `npm run cloud:takedown` and `cloud:publishers`: `openssl rand -hex 32`.
PRODUCTDOC_ADMIN_TOKEN=

# Sign-in. Each provider turns on once both its values are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
