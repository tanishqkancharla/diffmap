{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm install",
  "buildCommand": "npx vite build",
  "outputDirectory": "dist",
  "trailingSlash": false,
  "functions": {
    "api/docs.ts": {
      "includeFiles": "dist/{pages/**,404.html,viewer.html,llms.txt,robots.txt,sitemap.xml}"
    }
  },
  "routes": [
    { "src": "^/(?:index\\.html)?$", "dest": "/api/docs?path=/" },
    {
      "src": "^/(llms\\.txt|robots\\.txt|sitemap\\.xml)$",
      "dest": "/api/docs?path=/$1"
    },
    { "src": "^/pages(?:/.*)?$", "dest": "/api/docs?path=/404" }
  ],
  "rewrites": [
    { "source": "/index.md", "destination": "/api/docs?path=/index.md" },
    { "source": "/docs/:path*", "destination": "/api/docs?path=/docs/:path*" },
    { "source": "/examples.md", "destination": "/api/docs?path=/examples.md" },
    {
      "source": "/examples/:path*",
      "destination": "/api/docs?path=/examples/:path*"
    },
    { "source": "/privacy", "destination": "/api/docs?path=/privacy" },
    { "source": "/privacy.md", "destination": "/api/docs?path=/privacy.md" },
    { "source": "/g", "destination": "/viewer.html" },
    { "source": "/g/:path*", "destination": "/viewer.html" },
    {
      "source": "/:owner/:repo/pull/:n",
      "destination": "/viewer.html"
    },
    {
      "source": "/:owner/:repo/pull/:n/:path*",
      "destination": "/viewer.html"
    },
    {
      "source": "/:owner/:repo/commit/:sha",
      "destination": "/viewer.html"
    },
    {
      "source": "/:owner/:repo/commit/:sha/:path*",
      "destination": "/viewer.html"
    }
  ]
}
