{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm install",
  "buildCommand": "npx vite build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/g", "destination": "/index.html" },
    { "source": "/g/:path*", "destination": "/index.html" },
    {
      "source": "/:owner/:repo/pull/:n",
      "destination": "/index.html"
    },
    {
      "source": "/:owner/:repo/pull/:n/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/:owner/:repo/commit/:sha",
      "destination": "/index.html"
    },
    {
      "source": "/:owner/:repo/commit/:sha/:path*",
      "destination": "/index.html"
    }
  ]
}
